# Copy to .env (next to static_drone.py), then adapt.
# All values except ROSBRIDGE_URL/DOMAIN and ROSBRIDGE_TOKEN have a default.

# ── Identity and connection ────────────────────────────────────────────────────
DRONE_ID=static_01
# Full URL, or leave empty and set DOMAIN (→ wss://rosbridge.$DOMAIN)
ROSBRIDGE_URL=wss://rosbridge.example.com
#DOMAIN=example.com
# Same token as on the VPS (Authorization: Bearer header, checked by rosbridge-proxy)
ROSBRIDGE_TOKEN=change-me

# ── NAO relay (ADR 006, see nao-relay/README.md) ──────────────────────────
# Only used by the nao-relay service (Caddy), not by static_drone.py.
# VPS rosbridge over https:// (same host as ROSBRIDGE_URL)
NAO_RELAY_UPSTREAM=https://rosbridge.example.com
# Accepted addresses. Left commented out = the whole local network
# (an empty NAO_IP line would refuse everything).
#NAO_IP=192.168.1.42
#NAO_RELAY_PORT=9090

# ── Microphones ───────────────────────────────────────────────────────────────────
# Audio input: (partial) name or index (python3 -m sounddevice for the list).
# Empty = ReSpeaker if plugged in, otherwise the default input (on Ubuntu: the
# microphone chosen in Settings > Sound, see pc-portable-ubuntu.md).
#AUDIO_INPUT_DEVICE=
# If the input refuses this rate, its default rate is used.
SAMPLE_RATE=16000
# Channel recorded and sent (0 = processed audio on the ReSpeaker)
RECORD_CHANNEL=0
# Without ReSpeaker, ≥ 2 mics: one name:angle per input channel, in order.
# Angle in degrees, 0 = camera axis, positive = to the right.
#MICS=gauche:-60,droite:60
MICS=

# ── ReSpeaker USB Mic Array v2.0 ─────────────────────────────────────────────
# auto = used if detected, 0 = ignored, 1 = required
RESPEAKER=auto
# 1 if the speaker is plugged into the ReSpeaker's jack output (echo
# cancellation): listening then stays active while the drone speaks.
RESPEAKER_AEC=0
# Offset (degrees) added to the measured angle to align it with the camera
DOA_OFFSET=0
# 1 if the ReSpeaker angle turns the other way from the convention
DOA_INVERT=0

# ── Speech detection (without ReSpeaker) ─────────────────────────────────────
# RMS threshold on 16-bit samples (0..32767); see the README to tune it
RMS_THRESHOLD=500
# Silence (s) that ends a recording
SILENCE_S=0.8
# Minimum speech (s) to send: a lone "ok nao" lasts barely 0.3 s
MIN_SPEECH_S=0.2
MAX_RECORD_S=15
PRE_ROLL_S=0.3

# ── "ok nao" wake word ────────────────────────────────────────────────────
# server = every sentence goes to the VPS, body-gateway looks for "ok nao" in it;
# local  = openWakeWord on the drone, only the following sentence is sent
WAKE_MODE=server
# Name of a models/<name>.onnx file, path to an .onnx, or a model provided by
# openWakeWord to try (hey_jarvis, alexa, hey_mycroft). See models/README.md
WAKE_MODEL=ok_nao
# Score (0..1) to exceed; LOG_LEVEL=DEBUG shows the max score of each second
WAKE_THRESHOLD=0.5
# Wait for the start of the sentence after "ok nao" (s)
WAKE_LISTEN_S=5
# Audio kept before detection, so as not to cut "ok nao quelle heure…" (s)
WAKE_PRE_ROLL_S=0.5

# ── Speaker ─────────────────────────────────────────────────────────────
# Command that plays an MP3 from standard input
PLAYER_CMD=mpg123 -q -
#PLAYER_CMD=mpg123 -q -a hw:ArrayUAC10,0 -
PLAYBACK_TAIL_S=0.3
# Phrase liée à un geste appris du NAO : elle attend le départ du geste (le
# décalage parole / geste se règle dans emotion_gesture.env,
# GESTURE_SPEECH_OFFSET_MS). Attente maximale, en secondes, avant de la dire
# quand même (geste refusé ou service des gestes arrêté).
SPEECH_SYNC_MAX_WAIT_S=4

# ── Camera ───────────────────────────────────────────────────────────────────
# Index (0, 2…), path (/dev/video2, /dev/v4l/by-id/…) or partial name given by
# v4l2-ctl --list-devices (e.g. C920). On a laptop, 0 is often the
# built-in camera and the USB webcam shows up as 2.
CAMERA_INDEX=0
# Horizontal field of view (degrees)
CAMERA_HFOV=66
CAMERA_WIDTH=320
CAMERA_HEIGHT=240
CAMERA_FPS=5
JPEG_QUALITY=70
MOTION_THRESHOLD=25
# Image published every N s (0 = only on request)
IMAGE_INTERVAL=10

# ── Misc ───────────────────────────────────────────────────────────────────
STATUS_INTERVAL=30
RECONNECT_MAX_S=30
# Duration of an audio block (ms)
BLOCK_MS=30
LOG_LEVEL=INFO
