# systemd "user" service for the static drone, for a desktop Ubuntu PC
# (laptop…): it runs in the user's session and therefore
# has access to PipeWire/PulseAudio sound (microphone and speaker chosen in
# Settings > Sound). See pc-portable-ubuntu.md. Installation:
#   mkdir -p ~/.config/systemd/user
#   cp static-drone-user.service ~/.config/systemd/user/static-drone.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now static-drone
#   sudo loginctl enable-linger $USER     # starts without opening a session
#   journalctl --user -u static-drone -f
#
# %h = home folder. Adapt the path if the repository is not in ~/ia-agent.
# The .env file next to static_drone.py is read by the program itself.

[Unit]
Description=ia-agent static drone (microphones, camera, speaker)
Wants=pipewire.service pipewire-pulse.service
After=pipewire.service pipewire-pulse.service

[Service]
Type=simple
WorkingDirectory=%h/ia-agent/robotics/drones/static/onboard
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/ia-agent/robotics/drones/static/onboard/.venv/bin/python static_drone.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
