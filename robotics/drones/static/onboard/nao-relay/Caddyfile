# NAO relay (ADR 006): the NAO talks ws:// to the drone on the local network;
# Caddy relays to rosbridge on the VPS over TLS (wss) and adds the token.
# The VPS thus no longer needs to accept plain HTTP.
# Variables read from the drone's .env (see .env.example):
#   NAO_RELAY_UPSTREAM  VPS rosbridge (e.g. https://rosbridge.mydomain.com)
#   ROSBRIDGE_TOKEN     same token as on the VPS
#   NAO_IP              accepted addresses (default: the whole local network)
#   NAO_RELAY_PORT      listening port (default 9090)

{
	admin off
}

:{$NAO_RELAY_PORT:9090} {
	@local remote_ip {$NAO_IP:192.168.0.0/16 172.16.0.0/12 10.0.0.0/8 127.0.0.1}

	handle @local {
		reverse_proxy {$NAO_RELAY_UPSTREAM} {
			# Traefik routes on the VPS name, not on the drone's IP
			header_up Host {upstream_hostport}
			header_up Authorization "Bearer {$ROSBRIDGE_TOKEN}"
		}
	}

	# The token never leaves the local network, even if port 9090 is exposed
	handle {
		respond "Forbidden outside the local network" 403
	}

	log {
		output stderr
		format console
	}
}
