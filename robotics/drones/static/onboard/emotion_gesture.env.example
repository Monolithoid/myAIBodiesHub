# Copier en emotion_gesture.env (à côté de emotion_gesture.py) puis adapter.
# Version du générateur de gestes appris (nao-emotion-motion) utilisée par le NAO.
# Fixée à la main : le service ne suit jamais la branche main de lui-même.
# Changer de version = changer GESTURE_DATASET_REF, puis « recharger » depuis la
# régie (/nao/emotion_gesture_control {"op": "reload"}) ou redémarrer le service.

# Dépôt public du dataset (generator/nao_gesture.py + generator/nao_gesture.json)
GESTURE_DATASET_REPO=Monolithoid/nao-emotion-motion-dataset
# Tag (ex. v2026-11-18) ou commit complet (40 caractères). Obligatoire.
GESTURE_DATASET_REF=
# Une copie vérifiée par version (sha256 de dataset.json) : revenir à une
# version déjà vue ne demande pas de réseau.
#GESTURE_CACHE_DIR=~/.cache/nao-gesture
# Secondes sans nouveau geste avant le retour au repos (le robot reste raide à
# la pose de départ entre deux gestes rapprochés).
#GESTURE_REST_DELAY=3
# Points par seconde envoyés au robot pour ALMotion.angleInterpolation
#GESTURE_RATE_HZ=25

# ── Synchronisation avec la parole ──────────────────────────────────────────
# Quand une réponse du LLM contient une phrase et un geste, le haut-parleur du
# drone retient la phrase jusqu'au début de la partie expressive du geste
# (après le passage du robot à sa pose de départ), puis la dit.
#
# Décalage entre ce début et la parole, en millisecondes, à régler à l'oreille
# et à l'œil : positif = la parole part APRÈS le début du geste, négatif = AVANT
# (le geste attend alors d'autant si besoin). Entre -10000 et 10000.
# Réglable à chaud depuis la régie (page Robot), jusqu'au prochain « Recharger ».
#GESTURE_SPEECH_OFFSET_MS=0
# 1 = la durée de la partie expressive du geste est calée sur celle de la
# parole (durée mesurée du MP3 de la synthèse vocale). 0 = vitesse apprise.
#GESTURE_MATCH_SPEECH=1
# Facteurs de durée permis : un geste plus court que la parole est ralenti
# jusqu'à x3 ; plus long, il n'est accéléré que si le guardian l'accepte
# encore (au mieux x0.7).
#GESTURE_SPEECH_SCALE_MIN=0.7
#GESTURE_SPEECH_SCALE_MAX=3
# Attente maximale (s) de la durée mesurée de la phrase avant d'utiliser
# l'estimation faite par body_gateway d'après le texte.
#GESTURE_SPEECH_WAIT_S=3

# La connexion rosbridge (ROSBRIDGE_URL / DOMAIN, ROSBRIDGE_TOKEN) est lue dans
# le .env du drone, comme pour static_drone.py.
