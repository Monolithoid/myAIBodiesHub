# Copy to emotion_gesture.env (next to emotion_gesture.py), then adapt.
# Version of the learned gesture generator (nao-emotion-motion) used by the NAO.
# Pinned by hand: the service never follows the main branch on its own.
# Changing version = changing GESTURE_DATASET_REF, then "reload" from the
# control room (/nao/emotion_gesture_control {"op": "reload"}) or restart the service.

# Public dataset repository (generator/nao_gesture.py + generator/nao_gesture.json)
GESTURE_DATASET_REPO=Monolithoid/nao-emotion-motion-dataset
# Tag (e.g. v2026-11-18) or full commit (40 characters). Required.
GESTURE_DATASET_REF=
# One verified copy per version (sha256 from dataset.json): going back to a
# version already seen needs no network.
#GESTURE_CACHE_DIR=~/.cache/nao-gesture
# Seconds without a new gesture before returning to rest (the robot stays stiff in
# the start pose between two close gestures).
#GESTURE_REST_DELAY=3
# Points per second sent to the robot for ALMotion.angleInterpolation
#GESTURE_RATE_HZ=25

# ── Synchronisation with speech ─────────────────────────────────────────────
# When an LLM answer contains a sentence and a gesture, the drone's speaker
# holds the sentence back until the start of the gesture's expressive part
# (after the robot has moved to its start pose), then says it.
#
# Offset between that start and the speech, in milliseconds, to tune by ear
# and eye: positive = speech starts AFTER the start of the gesture, negative =
# BEFORE (the gesture then waits that long if needed). Between -10000 and 10000.
# Can be changed live from the control room (Robot page), until the next reload.
#GESTURE_SPEECH_OFFSET_MS=0
# 1 = the duration of the gesture's expressive part is fitted to that of the
# speech (measured duration of the speech synthesis MP3). 0 = learned speed.
#GESTURE_MATCH_SPEECH=1
# Allowed duration factors: a gesture shorter than the speech is slowed down
# up to x3; if longer, it is only sped up if the guardian still accepts it
# (at best x0.7).
#GESTURE_SPEECH_SCALE_MIN=0.7
#GESTURE_SPEECH_SCALE_MAX=3
# Maximum wait (s) for the measured sentence duration before using the
# estimate made by body_gateway from the text.
#GESTURE_SPEECH_WAIT_S=3

# The rosbridge connection (ROSBRIDGE_URL / DOMAIN, ROSBRIDGE_TOKEN) is read from
# the drone's .env, as for static_drone.py.
