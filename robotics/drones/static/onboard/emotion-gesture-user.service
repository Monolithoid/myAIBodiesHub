# systemd "user" service for the NAO's learned gestures (ADR 009), next to
# static-drone. Installation:
#   mkdir -p ~/.config/systemd/user
#   cp emotion-gesture-user.service ~/.config/systemd/user/emotion-gesture.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now emotion-gesture
#   journalctl --user -u emotion-gesture -f
#
# %h = home folder. Adapt the path if the repository is not in ~/ia-agent.
# emotion_gesture.env (generator version) and .env (rosbridge) are read by
# the program itself.

[Unit]
Description=NAO learned gestures (nao-emotion-motion generator)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ia-agent/robotics/drones/static/onboard
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/ia-agent/robotics/drones/static/onboard/.venv/bin/python emotion_gesture.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
