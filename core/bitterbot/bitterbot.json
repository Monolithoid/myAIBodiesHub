// Bitterbot — 100% local configuration
// Copy this file to: /opt/ia/bitterbot/config/bitterbot.json
// Generate the gateway token: openssl rand -hex 32
//
// Components disabled on purpose:
//   - All messaging channels (WhatsApp, Telegram, Discord, Signal, Slack)
//   - Wide-area P2P discovery (libp2p / Gossipsub)
//   - Stripe onramp (no cloud key configured)
//
// Active components:
//   - 100% local inference through Ollama (http://ollama:11434)
//   - Dream Engine (memory consolidation every 2 hours)
//   - Document ingestion (workspace)
//   - WebSocket gateway + OpenAI-compatible API on port 19001
//
// Schema validated on version 2026.2.15 (SHA 85b5095) with bitterbot doctor --fix

{
  models: {
    providers: {
      ollama: {
        baseUrl: "http://ollama:11434",
        apiKey: "ollama-local",
        // Native Ollama API: simultaneous streaming + tool calling
        api: "ollama",
        // id + name both required
        models: [
          { id: "qwen2.5:7b", name: "Qwen 2.5 7B" },
        ],
      },
    },
  },

  agents: {
    defaults: {
      // model must be an object { primary, fallbacks? }, not a string
      model: {
        primary: "ollama:qwen2.5:7b",
      },
      workspace: "/home/node/.bitterbot/workspace",
    },
  },

  // Messaging channels disabled by omission (enabled is invalid at the channel root)

  discovery: {
    // enabled is invalid at the root — must be under wideArea
    wideArea: {
      enabled: false,
    },
  },

  gateway: {
    // "local" = standalone gateway with no dependency on the Bitterbot cloud
    mode: "local",
    auth: {
      // Must match BITTERBOT_GATEWAY_TOKEN in docker-compose.yml exactly
      token: "CHANGE_THIS_BITTERBOT_TOKEN",
    },
  },
}
